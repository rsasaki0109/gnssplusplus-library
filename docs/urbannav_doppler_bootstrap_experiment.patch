+bool DopplerBootstrapConfirmation::observe(
+    const Eigen::Vector3d& candidate, const GNSSTime& time,
+    const Eigen::Vector3d& velocity, bool fresh_velocity,
+    double max_distance_m, int required_epochs) {
+    if (!candidate.allFinite() || !std::isfinite(time - time) ||
+        !(max_distance_m > 0.0) || !std::isfinite(max_distance_m) || required_epochs < 1) {
+        reset();
+        return false;
+    }
+    const double dt = time - time_;
+    // A second acceptance path in the same epoch is not another observation.
+    if (count_ > 0 && dt == 0.0) return false;
+    const bool can_propagate = count_ > 0 && std::isfinite(dt) &&
+        dt > 0.0 && dt <= 2.0 && fresh_velocity && velocity.allFinite();
+    const Eigen::Vector3d predicted = predicted_position_ + velocity * dt;
+    if (can_propagate && predicted.allFinite() &&
+        (candidate - predicted).norm() <= max_distance_m) {
+        predicted_position_ = predicted;  // Do not walk the seed toward each candidate.
+        if (count_ < required_epochs) ++count_;
+    } else {
+        predicted_position_ = candidate;
+        count_ = 1;
+    }
+    time_ = time;
+    return count_ >= required_epochs;
+}
