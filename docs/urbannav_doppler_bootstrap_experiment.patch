+bool RTKProcessor::validateFixedDopplerBootstrap(const Vector3d& position,
+                                                const GNSSTime& current_time) {
+    if (isMovingBasePositionMode(rtk_config_) ||
+        !(rtk_config_.max_fixed_doppler_consensus_m > 0.0) ||
+        has_doppler_continuity_position_ ||
+        rtk_config_.fixed_doppler_bootstrap_epochs <= 1) {
+        return true;
+    }
+    doppler_bootstrap_checked_this_epoch_ = true;
+    const double velocity_age = current_time - last_doppler_velocity_time_;
+    const bool fresh_velocity = has_last_doppler_velocity_ &&
+        std::isfinite(velocity_age) && velocity_age >= 0.0 && velocity_age <= 2.0;
+    const bool confirmed = doppler_bootstrap_confirmation_.observe(
+        position, current_time, last_doppler_velocity_ecef_, fresh_velocity,
+        rtk_config_.max_fixed_doppler_consensus_m,
+        rtk_config_.fixed_doppler_bootstrap_epochs);
+    debug_telemetry_.fixed_doppler_bootstrap_streak = doppler_bootstrap_confirmation_.count();
+    if (!confirmed) debug_telemetry_.reject_reason = "fixed_doppler_bootstrap_pending";
+    return confirmed;
+}
