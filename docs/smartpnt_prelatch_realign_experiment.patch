+    // EXP (not for merge): with the consider update before the latch, nothing corrects the tilt or the
+    // gyro bias while the vehicle stands still, so a static-alignment window that caught an IMU start-up
+    // transient integrates into the tilt. Re-align over the whole current stand-still instead (yaw kept).
+    static const bool exp_realign = std::getenv("GNSS_EXP_PRELATCH_REALIGN") != nullptr;
+    if (exp_realign && config_.consider_attitude_and_biases_before_heading_latch && !heading_aligned_) {
+        if (gnssSpeedGateAllowsZupt() && detectStationary()) {
+            if (exp_still_count_ == 0.0) exp_still_start_tow_ = sample_body_flu.time.tow;
+            exp_still_gyro_sum_ += sample_body_flu.gyro_raw_radps;
+            exp_still_accel_sum_ += sample_body_flu.accel_raw;
+            exp_still_count_ += 1.0;
+            const double tow = sample_body_flu.time.tow;
+            if (tow - exp_still_start_tow_ >= 2.0 && tow - exp_last_realign_tow_ >= 1.0) {
+                const Eigen::Vector3d gyro_mean = exp_still_gyro_sum_ / exp_still_count_;
+                const Eigen::Vector3d accel_mean = exp_still_accel_sum_ / exp_still_count_;
+                const double norm = accel_mean.norm();
+                if (norm > 1e-9 && gyro_mean.allFinite()) {
+                    const Eigen::Vector3d up_body = accel_mean / norm;
+                    Eigen::Quaterniond level =
+                        Eigen::Quaterniond::FromTwoVectors(up_body, Eigen::Vector3d::UnitZ()).normalized();
+                    // Keep the current yaw: the heading of body +X in ENU.
+                    const Eigen::Matrix3d r_now = state_.nominal.attitude_body_to_enu.toRotationMatrix();
+                    const Eigen::Matrix3d r_lvl = level.toRotationMatrix();
+                    const double yaw_now = std::atan2(r_now(1, 0), r_now(0, 0));
+                    const double yaw_lvl = std::atan2(r_lvl(1, 0), r_lvl(0, 0));
+                    const Eigen::Quaterniond turn(Eigen::AngleAxisd(yaw_now - yaw_lvl, Eigen::Vector3d::UnitZ()));
+                    state_.nominal.attitude_body_to_enu = (turn * level).normalized();
+                    state_.nominal.gyro_bias = gyro_mean;
+                    state_.nominal.accel_bias = accel_mean - kStandardGravityMps2 * up_body;
+                    exp_last_realign_tow_ = tow;
+                    ++exp_realign_count_;
+                }
+            }
+        } else {
+            exp_still_gyro_sum_.setZero();
+            exp_still_accel_sum_.setZero();
+            exp_still_count_ = 0.0;
+        }
+    }
+
