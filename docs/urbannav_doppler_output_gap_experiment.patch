+TEST(RTKDopplerConsensusTest, DopplerOnlyObservationsMaintainTrackWithoutPositionOutput) {
+    const auto nav = synthetic_rtk_scene::constellation();
+    const Vector3d rover_position(6378177.0, 30.0, 10.0);
+    const auto initial_time = synthetic_rtk_scene::epochTime(0.0);
+    const auto prns = synthetic_rtk_scene::visible(nav, initial_time, rover_position, 15.0);
+    ASSERT_GE(prns.size(), 6U);
+    RTKProcessor processor;
+    auto config = processor.getRTKConfig();
+    config.max_fixed_doppler_consensus_m = 3.0;
+    processor.setRTKConfig(config);
+    processor.setBasePosition(Vector3d(6378137.0, 0.0, 0.0));
+    Peer::has_doppler_continuity_position_(processor) = true;
+    Peer::doppler_continuity_position_ecef_(processor) = rover_position;
+    Peer::doppler_continuity_time_(processor) = initial_time;
+    Peer::has_last_doppler_velocity_(processor) = true;
+    Peer::last_doppler_velocity_ecef_(processor) = Vector3d::Zero();
+    Peer::last_doppler_velocity_time_(processor) = initial_time;
+    for (int epoch = 1; epoch <= 20; ++epoch) {
+        const auto time = synthetic_rtk_scene::epochTime(0.2 * epoch);
+        auto rover = synthetic_rtk_scene::observations(
+            nav, time, rover_position, 0.0, prns, 0.0, true);
+        for (auto& observation : rover.observations) {
+            observation.has_pseudorange = false;
+            observation.has_carrier_phase = false;
+        }
+        const auto solution = processor.processRTKEpoch(rover, ObservationData(time), nav);
+        // No code or phase position is available, but rover Doppler remains usable.
+        EXPECT_FALSE(solution.isValid());
+        EXPECT_TRUE(Peer::has_doppler_continuity_position_(processor));
+        EXPECT_NEAR(time - Peer::last_doppler_velocity_time_(processor), 0.0, 1e-8);
+        EXPECT_NEAR(time - Peer::doppler_continuity_time_(processor), 0.0, 1e-8);
+        EXPECT_LT(Peer::last_doppler_velocity_ecef_(processor).norm(), 0.1);
+        EXPECT_LT((Peer::doppler_continuity_position_ecef_(processor) - rover_position).norm(), 0.5);
+    }
+}
+
+TEST(RTKDopplerConsensusTest, MissingDopplerCannotRefreshVelocityOrPreserveTrackIndefinitely) {
+    RTKProcessor processor;
+    auto config = processor.getRTKConfig();
+    config.max_fixed_doppler_consensus_m = 3.0;
+    processor.setRTKConfig(config);
+    const auto initial_time = synthetic_rtk_scene::epochTime(0.0);
+    Peer::has_doppler_continuity_position_(processor) = true;
+    Peer::doppler_continuity_position_ecef_(processor) = Vector3d(6378177.0, 30.0, 10.0);
+    Peer::doppler_continuity_time_(processor) = initial_time;
+    Peer::has_last_doppler_velocity_(processor) = true;
+    Peer::last_doppler_velocity_ecef_(processor) = Vector3d::Zero();
+    Peer::last_doppler_velocity_time_(processor) = initial_time;
+    for (int epoch = 1; epoch <= 25; ++epoch) {
+        const auto time = synthetic_rtk_scene::epochTime(0.2 * epoch);
+        const auto solution = processor.processRTKEpoch(ObservationData(time), ObservationData(time), NavigationData{});
+        EXPECT_FALSE(solution.isValid());
+        EXPECT_NEAR(Peer::last_doppler_velocity_time_(processor) - initial_time, 0.0, 1e-8);
+    }
+    EXPECT_FALSE(Peer::has_doppler_continuity_position_(processor));
+}
