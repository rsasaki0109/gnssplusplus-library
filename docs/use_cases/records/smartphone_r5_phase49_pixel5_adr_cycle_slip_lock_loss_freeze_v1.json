  "adr_state_contract": {
    "valid_bit": 1,
    "reset_bit": 2,
    "cycle_slip_bit": 4,
    "half_cycle_reported_bit": 8,
    "half_cycle_resolved_bit": 16,
    "ordinary_unflagged": "valid bit set and reset/cycle-slip bits clear; half-cycle reported/resolved is retained as a separate state label",
    "state_labels": ["INVALID", "VALID", "RESET", "CYCLE_SLIP", "HALF_CYCLE_REPORTED", "HALF_CYCLE_RESOLVED", "VALID_PLUS_HALF_CYCLE_REPORTED", "VALID_PLUS_HALF_CYCLE_RESOLVED", "COMBINED_FLAGS"],
    "adapter_contract": "carrier_masked when valid bit is absent or reset/cycle-slip is set; LLI/loss_of_lock is raised for reset/cycle-slip; Pixel5 uses the adapter's non-negated ADR sign"
  },
  "fixed_equations": {
    "raw_pseudorange": "Phase25 integer/Decimal segment-base P reconstruction with constellation time mapping and nearest-week unwrap; no coordinate or navigation input",
    "signed_adr": "signed_ADR_m = -AccumulatedDeltaRangeMeters only for the adapter's five published sign-correction device models; Pixel5 preserves raw ADR sign; wavelength_m=c/CarrierFrequencyHz is reported",
    "ordinary_transition": "same SVID+signal adjacent Raw rows, 0<dt<=1.5 s, unchanged HCDC, finite in-range P, existing code/CN0/multipath masks clear, ADR valid/reset/slip clear, and finite signed ADR/rate",
    "adr_rate_residual": "r_k=(signed_ADR_k-signed_ADR_prev)-0.5*(PseudorangeRateMetersPerSecond_prev+PseudorangeRateMetersPerSecond_k)*dt_seconds; raw rate is direct m/s per Phase41",
    "clock_center": "for each endpoint utcTimeMillis+HCDC group, subtract the median raw ADR/rate residual over ordinary comparable pairs; retain raw and centered residual",
    "candidate_score": "candidate iff ordinary transition, abs(centered residual)>1.5 m (Phase13 carrier threshold), and immediately preceding and following transitions for the same sat/signal are also ordinary (two-sided adjacency); no result-fitted threshold",
    "clean": "ordinary transition not candidate; candidate score is diagnostic only and does not mask or alter an estimator",
    "normalization": "report abs centered residual divided by max positive adjacent PseudorangeRateUncertaintyMetersPerSecond*dt; Android has no direct ADR uncertainty field, so ADR uncertainty is explicitly unavailable",
    "stable_arc": "contiguous ordinary transitions on one sat/signal/segment with at least 30 pairs, matching the frozen Phase14 Hatch sample scale; candidate fraction is the false-positive proxy",
    "boundary_buckets": "reset/slip/invalid/HCDC/gap and missing/nonfinite ADR transitions are separately labeled and excluded from ordinary/candidate scoring"
  },
