  "candidate_method_contract": {
    "methods": [
      {
        "id": "coordinate_wise_ecef_median",
        "definition": "component-wise median over aligned finite phone ECEF coordinates",
        "parameters": {"minimum_phones": 2}
      },
      {
        "id": "geometric_median_ecef",
        "definition": "Weiszfeld geometric median over aligned finite phone ECEF coordinates",
        "parameters": {"maximum_iterations": 64, "convergence_tolerance_m": 0.000001}
      },
      {
        "id": "trimmed_mean_ecef",
        "definition": "coordinate-wise 20 percent symmetric trim when at least five phones, otherwise arithmetic mean",
        "parameters": {"trim_fraction": 0.2, "minimum_phones_for_trim": 5}
      }
    ],
    "selection_metric": "mean per-phone four local Kaggle diagnostic scores over train phone truth",
    "tie_break": "coordinate_wise_ecef_median, then geometric_median_ecef, then trimmed_mean_ecef",
    "truth_free_generation": true,
    "candidate_search_after_record": false
  },
  "atomic_contract": {
    "input_and_output_hashes": true,
    "aligned_unix_time_millis_exact_or_within_tolerance": true,
    "alignment_tolerance_ms": 1,
    "nonfinite_input_fail_closed": true,
    "missing_phone_fail_closed": false,
    "per_timestamp_phone_count_and_spread_manifest": true,
    "fused_position_and_submission_atomic": true,
    "truth_free_before_validation_truth": true,
