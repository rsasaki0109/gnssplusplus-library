  "algorithm_contract": {
    "entrypoint": "gnss_fgo_imu_no_base",
    "cli": [
      "--obs <truth-free adapter/rover.obs>",
      "--nav <raw broadcast brdc.nav>",
      "--android-imu <raw device_imu.csv>",
      "--out <atomic keyed CSV>",
      "--summary-json <atomic JSON>",
      "--dataset-id <route/phone>",
      "--skip-epochs 200",
      "--max-epochs 30"
    ],
    "graph": {
      "backend": "GTSAM",
      "pseudorange": true,
      "ordinary_tdcp": false,
      "carrier_phase": false,
      "motion": "existing FGO problem initialization",
      "pose3_state": true,
      "combined_imu_factor": true,
      "double_difference_factors": false,
      "base_factors": false,
      "fallback": "If raw IMU leveling/heading or CombinedImu convergence fails, run the exact existing no-IMU native FGO path and label fallback in summary."
    },
    "android_adapter": {
      "supported_message_types": ["UncalAccel", "UncalGyro"],
      "unsupported_rows_counted": true,
      "utc_to_gpst_leap_seconds": 18.0,
      "gyro_anchor_clock": "elapsedRealtimeNanos",
      "accel_alignment": "interior linear interpolation; endpoint nearest only when absolute offset <=0.025 s",
      "no_extrapolation": true,
      "duplicate_utc_policy": "first row retained per stream",
      "elapsed_clock_preserved_in_ImuSample": true,
      "gnss_elapsed_anchor_applied": false,
      "sync_gap": "Upstream GNSS obs.elapsedns -> obs.utcms interpolation and sync_coefficient=0.5 remain a separately identified gap."
    },
    "mounting": {
      "rotation": "Rz(-94 deg) * Ry(178 deg) * Rx(-85 deg)",
      "translation_m": [0.0, 0.0, 0.0],
      "raw_axes": "loader leaves raw sensor axes untouched; entrypoint applies frozen mounting matrix explicitly"
    },
    "numeric_parameters": {
      "gravity_mps2": 9.80665,
      "accel_noise_sigma": 0.025,
      "gyro_noise_sigma": 0.0005,
      "accel_bias_rw_sigma": 0.00025,
      "gyro_bias_rw_sigma": 0.0000005,
      "integration_sigma": 0.05,
      "init_attitude_sigma_roll_pitch_rad": 0.05,
      "init_attitude_sigma_yaw_rad": 0.08726646259971647,
      "init_velocity_sigma_mps": 0.5,
      "init_accel_bias_sigma": 0.1,
      "init_gyro_bias_sigma": 0.01,
      "gravity_norm_gate": [0.7, 1.3],
      "gravity_norm_std_max_mps2": 1.5,
      "stationary_samples": 250,
      "heading_window_epochs": 25,
      "required_heading_windows": 3,
      "heading_speed_mps": [2.0, 50.0],
      "heading_vertical_speed_max_mps": 3.0,
      "heading_consistency_rad": 0.3490658503988659,
      "fgo_max_iterations": 12
    }
  },
  "pre_truth_gate": {
    "required": [
