{
  "schema_version": "rtk-spp-epoch-reuse.v1",
  "variant": "same-epoch-spp-result-reuse",
  "role": "development-only",
  "decision": "no-go-removed",
  "status": "implementation-cli-telemetry-tests-removed",
  "reason": "The guarded cache was a substantial throughput improvement, but stateful iterative SPP convergence changed three rounded RTK update NIS fields and the unrounded ratio stream. The strict POS byte-identity requirement was therefore not met. The experiment, its CLI, dedicated telemetry, and dedicated tests were removed after the audit; no production or holdout evaluation was performed.",
  "implementation": {
    "config_field": "RTKProcessor::RTKConfig::reuse_spp_result_within_epoch (removed)",
    "cli_flag": "--reuse-rtk-spp-epoch (removed)",
    "cache_scope": "stack lifetime of one processRTKEpochInternal() call",
    "consumers": [
      "initializeFilter",
      "resetPositionToSPP"
    ],
    "key_guards": [
      "rover ObservationData object identity",
      "exact epoch time and full deterministic rover observation/tracking fingerprint",
      "NavigationData object identity and supported mutation revision",
      "navigation satellite/ephemeris counts and broadcast atmospheric model",
      "complete SPPConfig fingerprint",
      "precise/IONEX/DCB/SSR loaded flags and population counts",
      "valid finite SPP PositionSolution with matching timestamp"
    ],
    "fail_closed": [
      "revision-zero navigation fixture",
      "invalid/non-finite SPP",
      "changed input, time, navigation, SPP option, or correction-product state"
    ],
    "side_effect_contract": "No cross-epoch or cross-thread cache; a guard miss executes the existing processEpoch call. SPP standalone path is not changed."
  },
