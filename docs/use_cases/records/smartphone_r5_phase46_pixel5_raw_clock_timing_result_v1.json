  "finding": {
    "strongest": "Per-row FullBiasNanos changes at essentially every 1 Hz epoch while HCDC remains unchanged and no TimeNanos gap is strictly greater than 1 second. The Phase25 segment-base FullBias contract therefore diverges from the per-row FullBias contract by up to 98138 ns (29.421 km c-scaled) on MTV-a, 8292 ns (2.486 km) on MTV-h, 9514 ns (2.852 km) on LAX-t, and 20909 ns (6.268 km) on MTV-u.",
    "geometry_test": "The discrepancy is common receiver mode: same-epoch receiver-TOW spread is 0 m, same-epoch TimeNanos/FullBias/Bias/Drift/TimeOffset spreads are zero, and every available constellation/signal group has zero same-epoch median residual spread. It is a receiver-clock gauge, not an identified horizontal-geometry factor.",
    "utc_quality": "The direct Android hardware-clock GPS-to-UTC comparison is stable: all four detrended maxima are <=0.0121 ms and all absolute affine drifts are <=0.0475 ppm, far inside the frozen 2 ms and 1000 ppm gates.",
    "numeric_precision": "Exact integer/Decimal evaluation was retained; float64 subtraction risk reaches 256 ns, so large-nanosecond subtraction must not be used as the correction mechanism."
  },
  "decision": {
    "clock_correction_go": false,
    "clock_correction_reason": "No raw-only deployable clock correction is authorized: the only large structure is common-mode and the base-vs-row FullBias identity/boundary gates fail on all four routes.",
    "correction_implemented": false,
    "solver_rerun": false,
    "loo_or_truth_derived_inference": false,
    "next_single_raw_physical_factor": "satellite-specific raw code propagation/multipath residual",
    "next_factor_contract": "If a future phase is authorized, audit only the satellite/signal-dependent code propagation residual using raw ReceivedSvTimeNanos plus Android State/MultipathIndicator semantics. It must demonstrate non-common-mode, geometry-changing evidence before any implementation is authorized."
  },
