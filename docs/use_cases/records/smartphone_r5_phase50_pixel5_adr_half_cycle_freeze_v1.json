  "adr_state_contract": {
    "valid_bit": 1,
    "reset_bit": 2,
    "cycle_slip_bit": 4,
    "half_cycle_resolved_bit": 8,
    "half_cycle_reported_bit": 16,
    "ordinary_unflagged": "valid bit set and reset/cycle-slip bits clear; resolved/reported bits remain diagnostic state",
    "pair_classes": [
      "resolved_to_resolved",
      "unresolved_reported_stable",
      "resolved_toggle",
      "reported_toggle",
      "resolved_and_reported_toggle"
    ],
    "adapter_contract_to_audit": "current adapter carrier mask and LLI/loss_of_lock use reset/cycle-slip and valid bits only; half-cycle bits are not included in those gates or in TDCP arc reset"
  },
  "fixed_equations": {
    "raw_pseudorange": "Phase25 integer/Decimal segment-base P reconstruction with constellation time mapping and nearest-week unwrap; no coordinate or navigation input",
    "signed_adr": "signed_ADR_m = -AccumulatedDeltaRangeMeters only for the adapter's five published sign-correction device models; Pixel5 preserves raw ADR sign",
    "ordinary_transition": "same system/SVID/signal adjacent Raw rows, 0<dt<=1.5 s, unchanged HCDC, finite in-range P, existing code/CN0/multipath masks clear, valid ADR and reset/cycle-slip bits clear",
    "adr_rate_residual": "r_k=(signed_ADR_k-signed_ADR_prev)-0.5*(PseudorangeRateMetersPerSecond_prev+PseudorangeRateMetersPerSecond_k)*dt_seconds",
    "clock_center": "for each endpoint utcTimeMillis+HCDC group, subtract the median raw ADR/rate residual over ordinary comparable pairs; retain raw and centered residual",
    "half_cycle_normalized": "half_cycle_units = centered_residual_m / (0.5*c/CarrierFrequencyHz); an implicated toggle is clustered when distance to the nearest integer half-cycle is <=0.15",
    "implicated": "any ordinary pair with a resolved or reported state transition; state-stable ordinary pairs are clean comparators",
    "persistence": "toggle pair remains an ordinary pair with ordinary same-key predecessor and successor when both exist; adjacency is reported, not used to fit a threshold"
  },
