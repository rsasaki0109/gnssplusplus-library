  "decision": "no-go-removed",
  "status": "implementation-cli-telemetry-tests-removed",
  "reason": "The lookup-only candidate preserved every SPP call, state transition, iteration order, and QC decision and was POS-byte-identical. It did not improve performance: five-run Release median solver work increased by 0.171% and external wall median was unchanged. The experiment, CLI, dedicated telemetry, and dedicated tests were removed after the audit; no production or holdout evaluation was performed.",
  "root_cause_audit": {
    "full_spp_result_reuse": "Skipping the second SPP call also skipped stateful iterative/QC side effects, including estimated position, receiver clock, system-bias, and last-valid state updates. The changed seed propagated into three rounded RTKUpdateNIS fields and the unrounded ratio stream.",
    "lookup_only_candidate": "The candidate kept both SPP calls and shared only ordinary broadcast ephemeris selection/satellite-state lookup results. The route's eligible state-lookup counter stayed at zero, so the added guard and lookup bookkeeping had no measured benefit."
  },
  "implementation_removed": {
    "former_config_field": "RTKProcessor::RTKConfig::reuse_broadcast_satellite_state_within_epoch",
    "former_cli_flag": "--reuse-rtk-broadcast-state-epoch",
    "former_scope": "one processRTKEpochInternal() call",
    "former_guards": [
      "rover object/time/content identity",
      "navigation object/revision/shape",
      "complete SPP and processor options",
      "product populations and Galileo I/NAV override"
    ],
    "former_fail_closed_conditions": [
      "revision-zero navigation",
      "precise products",
      "SSR",
      "literal MRTKLIB IFLC path",
      "standalone smartphone SPP"
    ],
    "retained_optimization": "The process-internal BroadcastMeasurementCache in SPP solvePositionLS remains; no cross-call RTK cache remains."
  },
