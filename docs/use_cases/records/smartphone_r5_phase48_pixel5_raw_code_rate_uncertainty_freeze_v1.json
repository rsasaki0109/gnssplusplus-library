  "fixed_equations": {
    "raw_pseudorange": "Phase25 long-double-equivalent P=(tow_rx-tow_tx)*c using integer/Decimal segment-base receiver TOW, BiasNanos, TimeOffsetNanos, constellation mapping, and nearest-week unwrap.",
    "transition_domain": "Same SVID+signal consecutive Raw epochs with dt strictly >0 and <=1.5 s, unchanged HCDC, valid Android code/transmit state, finite PseudorangeRateMetersPerSecond, finite in-range P, and after existing MultipathIndicator/CN0 masks.",
    "raw_code_rate_residual": "e_k=(P_k-P_prev)-0.5*(PseudorangeRateMetersPerSecond_prev+PseudorangeRateMetersPerSecond_k)*dt_seconds; raw rate is used directly per Phase41 sign/unit contract.",
    "clock_center": "For each endpoint utcTimeMillis and HCDC clock group, subtract the median e_k across comparable satellites/signals; retain raw and centered values. Absolute centered residual is the uncertainty association metric.",
    "uncertainty_to_metres": "sigma_code_m=c*ReceivedSvTimeUncertaintyNanos/1e9; report raw PseudorangeRateUncertaintyMetersPerSecond separately and normalized abs centered residual/sigma_code_m when sigma>0.",
    "bucket_order": "<=10 ns, 10_to_100 ns, >100 ns; equality belongs to the lower closed bucket. Also report fixed log bins <1, 1_to_3, 3_to_10, 10_to_30, 30_to_100, >100 ns and quartiles.",
    "spearman": "Tie-averaged rank correlation between uncertainty nanos and abs centered residual, finite positive uncertainty only; no truth or route metric input.",
    "loo": "Recompute pooled bucket/Spearman direction after omitting each route; no correction or inference output is produced."
  },
  "existing_masks": {
    "source": "src/io/android_raw_gnss.cpp",
