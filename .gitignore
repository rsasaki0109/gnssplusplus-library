# Build artifacts
build/
build-*/
build_*/
bin/
*.a
*.o

# ROS 2 generated artifacts
ros2/install/
ros2/log/

# Data (large RINEX files)
data/

# Output
output/*
!output/.gitkeep

# Temporary files
*.log
*.txt
!CMakeLists.txt
test_rinex_read
test_rinex_read.cpp

# Generated (except docs/)
*.png
!docs/*.png
!tests/fixtures/**/*.png
*.html
!site-pages/**/*.html
!apps/commands/visualization/gnss_web.html
*.kml
*.pos
!tests/fixtures/**/*.pos
site/

# Explicit tracked text files
!requirements-docs.txt

# Python cache
__pycache__/
*.pyc

# IDE
.vscode/
.idea/
*.swp
PLAN.md
CLAUDE.md

# Credentials (never commit local authentication material)
.env
.env.*
!.env.example
**/access_token
**/kaggle.json

# External reference checkouts (e.g. MADOCALIB oracle)
/external/
